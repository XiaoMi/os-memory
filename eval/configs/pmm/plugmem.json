{
  "_comment": "Native construction config for PMM-Bench (Config A). Placeholders are filled by pmm_bench: {ROOT}, {BUILD_DIR}, {CONSTRUCTION_MODEL}, {EMBED_DIM}. api-embedder = the shared remote embedding API.",
  "config": {
    "source_dir": "{ROOT}/systems/plugmem/source",
    "model": {
      "provider": "openai",
      "name": "{CONSTRUCTION_MODEL}",
      "api_key_env": "OPENAI_API_KEY",
      "base_url_env": "OPENAI_BASE_URL"
    },
    "embedding_model": "api-embedder",
    "embedding_cache_size": 32768,
    "chroma_path": "{BUILD_DIR}/.chroma",
    "llm_cache_enabled": true,
    "llm_cache_path": "{BUILD_DIR}/plugmem_llm_cache.sqlite3",
    "llm_cache_seed_paths": [],
    "memory_goal": "Remember this user's timestamped device observations to answer personal history questions.",
    "top_k": 10
  },
  "extra_env": {
    "TOKENIZERS_PARALLELISM": "false",
    "HYPEREVAL_LLM_MIN_INTERVAL_SECONDS": "0.1",
    "PLUGMEM_STRUCTURING_WORKERS": "8",
    "PLUGMEM_EMBEDDING_BATCH_SIZE": "128",
    "EMBEDDING_MODEL": "api-embedder",
    "EMBEDDING_DIMENSION": "{EMBED_DIM}"
  }
}
