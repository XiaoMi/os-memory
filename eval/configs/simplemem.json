{
  "_comment": "SimpleMem 完整运行配置。run.py 读本文件, 把 {ROOT}=仓库根, {OUT_DIR}=本次运行输出目录 替换成实际路径。API key 由适配器从 OPENAI_API_KEY 环境变量读。SimpleMem 的嵌入模型不在 config 里, 而是靠环境变量 EMBEDDING_MODEL / EMBEDDING_DIMENSION 指定 (默认 Qwen3 需联网, 这里 _extra_env 覆盖成本地 bge)。",
  "_dataset": "locomo",
  "_data": {
    "smoke": "{ROOT}/data/locomo/locomo1.json",
    "full": "{ROOT}/data/locomo/locomo10.json"
  },
  "_sample_size": {
    "smoke": 1,
    "full": null
  },
  "_pythonpath": "{ROOT}/systems/simplemem/source",
  "_extra_env": {
    "EMBEDDING_MODEL": "{ROOT}/model/bge-base-en-v1.5",
    "EMBEDDING_DIMENSION": "768",
    "HYPEREVAL_LLM_MIN_INTERVAL_SECONDS": "0.1"
  },
  "source_dir": "systems/simplemem/source",
  "omni_source_dir": "{ROOT}/systems/simplemem/source/OmniSimpleMem",
  "model": {
    "provider": "openai",
    "name": "azure_openai/gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "base_url_env": "OPENAI_BASE_URL"
  },
  "db_path": "{OUT_DIR}/.lancedb",
  "table_name": "memory_entries",
  "clear_db": true,
  "enable_thinking": false,
  "use_streaming": false,
  "enable_planning": true,
  "enable_reflection": true,
  "max_reflection_rounds": 2
}
