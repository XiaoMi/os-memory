{
  "_comment": "LightMem 完整运行配置。run.py 读本文件, 把 {ROOT}=仓库根, {OUT_DIR}=本次运行输出目录 替换成实际路径。API key 由适配器从 OPENAI_API_KEY 环境变量读。官方 LoCoMo 流程: offline_update_all=真正抽取/巩固记忆; topic_segment/pre_compress 需要 llmlingua 压缩模型 (由 _extra_env 的 LLMLINGUA_PATH 指定本地模型)。",
  "_dataset": "locomo",
  "_data": {
    "smoke": "{ROOT}/data/locomo/locomo1.json",
    "full": "{ROOT}/data/locomo/locomo10.json"
  },
  "_sample_size": {
    "smoke": 1,
    "full": null
  },
  "_pythonpath": "{ROOT}/systems/lightmem/source_selected/src",
  "_extra_env": {
    "LLMLINGUA_PATH": "{ROOT}/model/llmlingua-2-bert-base-multilingual-cased-meetingbank",
    "HYPEREVAL_LLM_MIN_INTERVAL_SECONDS": "0.1"
  },
  "source_dir": "systems/lightmem/source_selected",
  "offline_update_all": true,
  "model": {
    "provider": "openai",
    "name": "azure_openai/gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "base_url_env": "OPENAI_BASE_URL"
  },
  "lightmem": {
    "pre_compress": true,
    "pre_compressor": {
      "model_name": "llmlingua-2",
      "configs": {
        "llmlingua_config": {
          "model_name": "{ROOT}/model/llmlingua-2-bert-base-multilingual-cased-meetingbank",
          "device_map": "cpu",
          "use_llmlingua2": true
        },
        "llmlingua2_config": {
          "max_batch_size": 50,
          "max_force_token": 100
        },
        "compress_config": {
          "instruction": "",
          "rate": 0.8,
          "target_token": -1
        }
      }
    },
    "topic_segment": true,
    "topic_segmenter": {
      "model_name": "llmlingua-2",
      "configs": {}
    },
    "precomp_topic_shared": true,
    "messages_use": "user_only",
    "metadata_generate": true,
    "text_summary": true,
    "memory_manager": {
      "model_name": "openai",
      "configs": {
        "model": "azure_openai/gpt-4o-mini",
        "num_gpu": -1,
        "max_tokens": 4096
      }
    },
    "extract_threshold": 0.1,
    "index_strategy": "embedding",
    "text_embedder": {
      "model_name": "huggingface",
      "configs": {
        "model": "{ROOT}/model/bge-base-en-v1.5",
        "embedding_dims": 768,
        "model_kwargs": {
          "device": "cpu"
        }
      }
    },
    "retrieve_strategy": "embedding",
    "embedding_retriever": {
      "model_name": "qdrant",
      "configs": {
        "collection_name": "memorybench_lightmem",
        "embedding_model_dims": 768,
        "path": "{OUT_DIR}/.qdrant"
      }
    },
    "update": "offline"
  }
}
