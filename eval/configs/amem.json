{
  "_comment": "A-MEM 完整运行配置。run.py 读本文件, 把 {ROOT}=仓库根, {OUT_DIR}=本次运行输出目录 替换成实际路径。API key 由适配器从 OPENAI_API_KEY 环境变量读。以 _ 开头的是给 run.py 的元字段。A-MEM 的嵌入模型由 model_name 指定 (SentenceTransformer 加载本地路径, 无 GPU 自动用 CPU)。",
  "_dataset": "locomo",
  "_data": {
    "smoke": "{ROOT}/data/locomo/locomo1.json",
    "full": "{ROOT}/data/locomo/locomo10.json"
  },
  "_sample_size": {
    "smoke": 1,
    "full": null
  },
  "_pythonpath": "{ROOT}/systems/amem/source",
  "_extra_env": {
    "HYPEREVAL_LLM_MIN_INTERVAL_SECONDS": "0.1"
  },
  "source_dir": "systems/amem/source",
  "model_name": "{ROOT}/model/bge-base-en-v1.5",
  "llm_backend": "openai",
  "llm_model": "azure_openai/gpt-4o-mini",
  "model": {
    "provider": "openai",
    "name": "azure_openai/gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "base_url_env": "OPENAI_BASE_URL"
  },
  "evo_threshold": 100,
  "consolidate": false
}
