{
  "_comment": "Mem0 完整运行配置。run.py 读本文件, 把 {ROOT}=仓库根, {OUT_DIR}=本次运行输出目录 替换成实际路径。API key 不写这里, 由适配器从 OPENAI_API_KEY 环境变量读 (见 .env)。以 _ 开头的是给 run.py 的元字段, 不传给适配器。MEM0_TELEMETRY=false 关闭 mem0 的匿名埋点统计: 它会另建一个路径写死在 ~/.mem0/migrations_qdrant 的 Qdrant 库 (仅用于给 mem0 官方 PostHog 上报匿名使用统计, 与评测无关), 该全局路径在多个 mem0 进程并发时会因 Qdrant embedded 不支持同目录多实例而报错崩溃; 关掉它不影响任何评测结果。",
  "_dataset": "locomo",
  "_data": {
    "smoke": "{ROOT}/data/locomo/locomo1.json",
    "full": "{ROOT}/data/locomo/locomo10.json"
  },
  "_sample_size": {
    "smoke": 1,
    "full": null
  },
  "_pythonpath": "{ROOT}/systems/mem0/source",
  "_extra_env": {
    "MEM0_TELEMETRY": "false",
    "HYPEREVAL_LLM_MIN_INTERVAL_SECONDS": "0.1"
  },
  "source_dir": "systems/mem0/source",
  "infer": true,
  "model": {
    "provider": "openai",
    "name": "azure_openai/gpt-4o-mini",
    "api_key_env": "OPENAI_API_KEY",
    "base_url_env": "OPENAI_BASE_URL"
  },
  "llm": {
    "provider": "openai",
    "config": {
      "temperature": 0.1,
      "max_tokens": 4096,
      "enable_vision": true,
      "vision_details": "auto"
    }
  },
  "embedder": {
    "provider": "huggingface",
    "config": {
      "model": "{ROOT}/model/bge-base-en-v1.5",
      "embedding_dims": 768,
      "model_kwargs": {
        "device": "cpu"
      }
    }
  },
  "vector_store": {
    "provider": "qdrant",
    "config": {
      "collection_name": "memorybench_mem0_locomo",
      "path": "{OUT_DIR}/.qdrant",
      "embedding_model_dims": 768
    }
  }
}
