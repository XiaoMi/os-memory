+def test_parallel_retrieval_reuses_and_closes_executor(custom_store):
+    retriever = HybridRetriever(
+        llm_client=DeterministicLLM(),
+        vector_store=custom_store,
+        enable_planning=True,
+        enable_reflection=True,
+        enable_parallel_retrieval=True,
+        max_retrieval_workers=2,
+    )
+    executor = retriever._retrieval_executor
+    retriever._semantic_search = lambda query: []
+
+    assert retriever._execute_parallel_searches(["one", "two"]) == []
+    assert retriever._retrieval_executor is executor
+    assert retriever._execute_parallel_additional_searches(["three"], 1) == []
+    assert retriever._retrieval_executor is executor
+
+    retriever.close()
+
+    assert retriever._retrieval_executor is None
+    assert executor._shutdown
