+    def recall_question(
+        self,
+        query: Any,
+        question_image_paths: Optional[List[str]] = None,
+    ) -> str:
+        """Recall with both the textual question and its original images."""
+        text_context = self.recall(query)
+        visual_context = self._recall_question_images(question_image_paths or [])
+        if text_context and visual_context:
+            return f"{text_context}\n\n{visual_context}"
+        return text_context or visual_context
+
+    def _recall_question_images(
+        self,
+        image_paths: List[str],
+        top_k: int = 30,
+    ) -> str:
+        """Search stored visual memories using the raw query-image embeddings."""
+        if self.orchestrator is None or not image_paths:
+            return ""
+
+        ranked: Dict[str, float] = {}
+        for image_path in image_paths:
+            path = Path(image_path)
+            if not path.exists():
+                continue
+            try:
+                embedding = self.orchestrator.image_processor.generate_embedding(path)
+                if not embedding:
+                    continue
+                for mau_id, score in self.orchestrator.vector_store.search_visual(
+                    embedding, top_k=top_k
+                ):
+                    ranked[mau_id] = max(ranked.get(mau_id, float("-inf")), score)
+            except Exception:
+                continue
+
+        if not ranked:
+            return ""
+
+        items = []
+        for mau_id, score in sorted(
+            ranked.items(), key=lambda item: item[1], reverse=True
+        )[:top_k]:
+            mau = self.orchestrator.mau_store.get(mau_id)
+            if mau is None:
+                continue
+            item = {
+                "id": mau.id,
+                "summary": mau.summary,
+                "modality_type": mau.modality_type.value,
+                "timestamp": mau.timestamp,
+                "score": score,
+                "tags": mau.metadata.tags,
+                "has_raw_data": mau.raw_pointer is not None,
+                "metadata": mau.metadata.to_dict(),
+            }
+            if mau.details and isinstance(mau.details, dict):
+                item["details"] = mau.details
+            items.append(item)
+
+        formatted = self._format_items(items)
+        if not formatted:
+            return ""
+        return "=== Visual Similarity Retrieval from Question Image ===\n" + formatted
+
